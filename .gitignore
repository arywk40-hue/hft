.DS_Store

# =========================
# IDE / Editors
# =========================
.vscode/
.idea/

# =========================
# EBX / HFT Data
# =========================

# Raw CSV dataset — do NOT commit huge data files
data/raw/
data/*.csv
*.csv

# Processed data — Parquet files can be hundreds of MB
data/processed/
*.parquet

# Validation/cache artifacts
data/validated/

# =========================
# Generated Results
# =========================
# Generated analytical tables are kept locally and are indexed by
# results/README.md. The directory-level README remains reviewable.
results/*
!results/README.md
!results/freeze/
!results/freeze/development_freeze.json

# Generated figures are kept locally and are indexed by
# figures/README.md. The directory-level README remains reviewable.
figures/*
!figures/README.md
# Research reports are intentionally reviewable artifacts.
reports/*.html
reports/*.pdf

# Packaging/build output
build/
dist/
*.egg-info/

# =========================
# Secrets / Credentials
# =========================
.env
.env.*
*.pem
*.key

# =========================
# OS / Logs / Temporary
# =========================
*.log
*.tmp
*.temp
.DS_Store

# =========================
# Large model/checkpoint files
# =========================
*.pkl
*.pickle
*.joblib
*.h5
*.pt
*.pth
*.onnx

# =========================
# Local configuration
# =========================
config/local.yaml
config/local.yml

# =========================
# Final submission evidence allowlist
# =========================
# Raw CSV, Parquet partitions, model caches, and temporary generated files
# remain ignored. The following exceptions version-control only the
# documented tables, manifests, reports, model-comparison outputs, trade log,
# and figures required to review the final submission.
